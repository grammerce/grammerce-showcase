# =============================================================================
# Переменные окружения для модулей, вошедших в эту выборку.
#
# Это НЕ полный .env продукта: здесь только то, что реально читают
# опубликованные модули. Значения — заглушки, подставьте свои.
#
# Ни одна переменная не обязательна для запуска тестов: тесты используют
# SQLite и моки, а незаполненные интеграции просто выключаются.
# =============================================================================

# ─── База данных ─────────────────────────────────────────────────────────────
# Prod: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./local.db

# ─── Общие настройки приложения ──────────────────────────────────────────────
# production | staging | development. Неизвестное значение — падение на старте:
# оно трактовалось бы как «не production» и открыло бы mock-эндпоинты.
ENVIRONMENT=development

# Ключ подписи JWT и токенов статуса заказа. Сгенерировать: openssl rand -hex 32
SECRET_KEY=generate_me_openssl_rand_hex_32

# Общая строка, подмешиваемая к устаревшим SHA256-хэшам паролей (до перехода
# на bcrypt). Это pepper, а не соль: значение одно на всех пользователей,
# поэтому оно секретное и в коде отсутствует. Без переменной вход по старым
# хэшам не работает. Новые пароли на bcrypt от неё не зависят.
LEGACY_PASSWORD_SALT=

# Redis обязателен в production: без него сессии и FSM бота живут в памяти
# процесса и теряются при рестарте. Пусто — используется память.
REDIS_URL=

WEB_APP_URL=https://example.com
FRONTEND_URL=
BACKEND_URL=
BASE_URL=

# Telegram chat_id суперадминов платформы, через запятую.
# Пусто = вход суперадмина закрыт (fail-closed).
SUPERADMIN_TELEGRAM_IDS=

# Ограничение попыток входа
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен бота магазина от @BotFather. НЕ путать с TELEGRAM_BOT_TOKEN ниже.
BOT_TOKEN=your_shop_bot_token_here
ADMIN_IDS=123456789
STATIC_DIR=

# Токен ГЛАВНОГО бота платформы: через него уходят заявки менеджеру.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_BASE_URL=
PLATFORM_BOT_SHARED_SECRET=
PLATFORM_BOT_NOTIFY_URL=
# Числовой chat_id менеджера. Можно оставить пустым — заявки просто
# не будут отправляться в Telegram.
PLATFORM_MANAGER_CHAT_ID=

# ─── OAuth ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Платёжные провайдеры ────────────────────────────────────────────────────
# Если ключи не заданы, фабрика отдаёт MockGateway: магазин без подключённой
# платёжки продолжает принимать заказы, а не падает на оформлении.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_BILLING_RETURN_URL=

PAYME_ID=
PAYME_KEY=

UZUM_MERCHANT_ID=
UZUM_API_KEY=
# Белый список IP колбэков Uzum, через запятую
UZUM_ALLOWED_IPS=

# ─── Реквизиты продавца (для счетов и ЭСФ) ───────────────────────────────────
SELLER_COMPANY_NAME=
SELLER_INN=
SELLER_ACCOUNT=
SELLER_BANK_NAME=
SELLER_BANK_MFO=
SELLER_DIRECTOR=
SELLER_ADDRESS=
SELLER_PHONE=

# ─── Didox (электронные счета-фактуры) ───────────────────────────────────────
# mock | staging | production
DIDOX_MODE=mock
DIDOX_PARTNER_TOKEN=
DIDOX_LOGIN=
DIDOX_PASSWORD=
DIDOX_TIN=
DIDOX_API_URL=
DIDOX_MOCK_URL=

INVOICES_DIR=media/invoices
CONTRACTS_DIR=media/contracts

# ─── POS и учёт ──────────────────────────────────────────────────────────────
# mock | live
ACCOUNTING_MODE=mock

# ─── AI: карточка товара и описания ──────────────────────────────────────────
AI_PRODUCT_PROVIDER=mock
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_CARD_TEXT_PROVIDER=mock
AI_CARD_BG_COLOR=#FFFFFF
AI_CARD_FIT_STRATEGY=contain
# Кэши моделей удаления фона (rembg/numba)
U2NET_HOME=
NUMBA_CACHE_DIR=
